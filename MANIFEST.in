include README.md LICENSE.txt pyproject.toml setup.py
recursive-include foldtree2/config *.csv *.yaml *.yml
recursive-include foldtree2/config/3diphy_submats *
include foldtree2/mafft_tools/hex2maffttext
include foldtree2/mafft_tools/maffttext2hex
include foldtree2/madroot/mad
include foldtree2/raxml-ng/raxml-ng
include foldtree2/raxml-ng/LICENSE.txt
prune foldtree2/tests
prune foldtree2/notebooks
prune foldtree2/workflow
exclude foldtree2/scaling_experiment.py
exclude foldtree2/src/models/test_chebconv_rework.py
recursive-exclude * __pycache__ *.py[cod] *.h5 *.hdf5 *.pt *.pth *.pkl *.ipynb
prune models
prune runs
prune families
prune alphafold_benchmark
prune figures
prune tmp
